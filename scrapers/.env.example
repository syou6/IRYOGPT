# ===================================
# よやくらく スクレイパー設定
# .env にコピーして値を入力してください
# cp scrapers/.env.example .env
# ===================================

# --- サロンボード ---
SALONBOARD_ID=your_salonboard_id
SALONBOARD_PASSWORD=your_salonboard_password

# --- ミニモ ---
MINIMO_ID=your_minimo_id
MINIMO_PASSWORD=your_minimo_password

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxx

# --- よやくらくサイトID ---
SITE_ID=your_yoyakuraku_site_id

# --- 通知（LINE Messaging API）---
# LINE Notify は 2025/3/31 に終了。LINE Messaging API を推奨。
# LINE Developers Console でチャネルを作成:
# https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_ADMIN_USER_ID=your_line_user_id

# --- 通知（LINE Notify: レガシー）---
# 既存トークンがあればフォールバックとして使用
NOTIFY_LINE_TOKEN=your_line_notify_token

# --- APIサーバー ---
# よやくらく（Vercel）からのリクエスト認証用
SCRAPER_API_SECRET=your_random_secret_key

# --- スケジューラー ---
# 同期間隔（秒）: ランダムでこの範囲で実行
SYNC_INTERVAL_MIN=150
SYNC_INTERVAL_MAX=240

# --- ブラウザ ---
# true: ヘッドレス（画面なし、本番用）
# false: ブラウザ表示（デバッグ・セレクタ確認用）
HEADLESS=true
