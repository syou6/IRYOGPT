# systemdサービスファイル
# Xvfb（別サービス）+ zendriver（headless=False）で常時稼働
#
# 設置:
#   sudo cp scrapers/xvfb.service /etc/systemd/system/
#   sudo cp scrapers/yoyakuraku-scraper.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable xvfb yoyakuraku-scraper
#   sudo systemctl start xvfb yoyakuraku-scraper
#
# ログ確認:
#   sudo journalctl -u yoyakuraku-scraper -f

[Unit]
Description=Yoyakuraku Reservation Scraper & API
After=network.target xvfb.service
Requires=xvfb.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/IRYOGPT
EnvironmentFile=/home/IRYOGPT/scrapers/.env
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:99

ExecStart=/home/IRYOGPT/venv/bin/uvicorn scrapers.api_server:app --host 0.0.0.0 --port 8000

Restart=always
RestartSec=30

# メモリ制限（暴走防止）
MemoryMax=2G
MemoryHigh=1.5G

# ログ
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yoyakuraku-scraper

[Install]
WantedBy=multi-user.target
