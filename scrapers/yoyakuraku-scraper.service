# systemdサービスファイル
# Xvfb（別サービス）+ zendriver（headless=False）で常時稼働
#
# 設置:
#   sudo cp scrapers/xvfb.service /etc/systemd/system/
#   sudo cp scrapers/yoyakuraku-scraper.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable xvfb yoyakuraku-scraper
#   sudo systemctl start xvfb yoyakuraku-scraper
#
# ログ確認:
#   sudo journalctl -u yoyakuraku-scraper -f

[Unit]
Description=Yoyakuraku Reservation Scraper & API
After=network-online.target xvfb.service
Requires=xvfb.service
Wants=network-online.target
# 5分以内に5回再起動失敗 → 停止
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/home/IRYOGPT
EnvironmentFile=/home/IRYOGPT/scrapers/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONFAULTHANDLER=1
Environment=DISPLAY=:99

ExecStart=/home/IRYOGPT/venv/bin/uvicorn scrapers.api_server:app --host 0.0.0.0 --port 8000

Restart=on-failure
RestartSec=15
TimeoutStartSec=60
TimeoutStopSec=30

# --- リソース制限 ---
# Chrome はメモリとfdを大量消費する
MemoryHigh=1.5G
MemoryMax=2G
LimitNOFILE=65536
LimitNPROC=4096

# --- セキュリティ ---
NoNewPrivileges=yes
PrivateTmp=yes

# --- ログ ---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yoyakuraku-scraper
# ログレート制限（暴走防止）
LogRateLimitIntervalSec=30
LogRateLimitBurst=500

[Install]
WantedBy=multi-user.target
