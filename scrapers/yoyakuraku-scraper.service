# systemdサービスファイル
# ConoHaサーバーで常時稼働させる場合に使用
#
# APIサーバー + スケジューラーを一体で起動する。
# よやくらく（Vercel）からのリアルタイムチェックリクエストも受け付ける。
#
# 設置:
#   sudo cp scrapers/yoyakuraku-scraper.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable yoyakuraku-scraper
#   sudo systemctl start yoyakuraku-scraper
#
# ログ確認:
#   sudo journalctl -u yoyakuraku-scraper -f
#
# 再起動:
#   sudo systemctl restart yoyakuraku-scraper

[Unit]
Description=Yoyakuraku Reservation Scraper & API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/IRYOGPT
ExecStart=/home/ubuntu/IRYOGPT/venv/bin/uvicorn scrapers.api_server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1

# ログ
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
